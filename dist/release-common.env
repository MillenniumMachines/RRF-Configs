#!/usr/bin/env bash
WD="${PWD}"
DIST_DIR="${WD}/dist"
RNOTES_PATH="${DIST_DIR}/RELEASE_NOTES.md"
SYS_DIR="sys"
WWW_DIR="www"
FIRMWARE_DIR="firmware"
MACRO_DIR="macros"
GCODE_DIR="gcodes"
# --checksum: an override file can have the same size as the file it
# replaces (e.g. speed.g), and a fresh checkout gives both the same mtime.
# rsync's default size+mtime check would then skip the override.
SYNC_CMD="rsync -a --checksum --exclude=README.md --exclude=*.env"
COMMIT_ID=$(git describe --tags --exclude "release-*" --always --dirty)

MILLENNIUMOS_RELEASES="https://github.com/MillenniumMachines/MillenniumOS/releases/download"
TEAMGLOOMY_RELEASES="https://github.com/gloomyandy/RepRapFirmware/releases/download"
DUET_RELEASES="https://github.com/Duet3D/RepRapFirmware/releases/download"